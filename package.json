{
  "name": "snippr",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && node scripts/deploy-migrations.mjs && next build",
    "dev": "node scripts/check-db.mjs && next dev",
    "start": "node scripts/check-db.mjs && next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.mts",
    "test:e2e": "playwright test",
    "e2e:db": "node scripts/e2e-db.mjs",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "node scripts/check-db.mjs && prisma migrate dev",
    "db:studio": "node scripts/check-db.mjs && prisma studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.88.0",
    "@auth/prisma-adapter": "^2.11.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@prisma/client": "^5.22.0",
    "next": "16.4.2",
    "next-auth": "^4.24.15",
    "prisma": "^5.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shiki": "^4.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.39",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
