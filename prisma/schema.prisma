generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  snippets      Snippet[]
  folders       Folder[]
  aiUsage       AiUsage[]
  // Set only for demo guests: after this the guest is signed out and can be
  // deleted, along with everything it owns. See docs/adr/0012.
  guestExpiresAt DateTime?
  createdAt     DateTime  @default(now())
  @@index([guestExpiresAt])
}

model Folder {
  id        String    @id @default(cuid())
  name      String
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  snippets  Snippet[]
  createdAt DateTime  @default(now())
}

model Snippet {
  id          String   @id @default(cuid())
  title       String
  code        String
  language    String
  tags        String[]
  description String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  folderId    String?
  folder      Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// One row per user, AI endpoint, and rate-limit window. See docs/adr/0011.
model AiUsage {
  userId      String
  bucket      String
  windowStart DateTime
  count       Int      @default(0)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([userId, bucket, windowStart])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}